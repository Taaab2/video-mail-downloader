# להרצה מקומית של תהליך ההורדה (ב-GitHub Actions הערכים מגיעים מ-Secrets).
# העתיקו ל-.env ומלאו. בקובץ הזה אין סודות אמיתיים.

MAIL_USER=you@gmail.com
MAIL_PASSWORD=app-password-16-chars
MAIL_FROM=you@gmail.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# נדרש להעלאה ל-Releases (בהרצה מקומית: טוקן אישי עם הרשאת contents:write)
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
