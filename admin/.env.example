# הגדרות מקומיות של ממשק הניהול – הקובץ האמיתי הוא admin/.env והוא לא נכנס ל-Git.
# אפשר למלא גם מתוך הממשק עצמו (לשונית "סקירה" ו"הגדרות").

# טוקן GitHub (fine-grained): Contents / Actions / Secrets / Variables = Read and write
GITHUB_TOKEN=

# המאגר שאליו נדחף הקוד, בצורה owner/repo. אם ריק – מזוהה אוטומטית מה-remote של git.
GITHUB_REPO=

# הפורט של הממשק המקומי
ADMIN_PORT=8765

# פרטי המייל – נכתבים ל-Secrets של GitHub ומשמשים גם לבדיקה המקומית
MAIL_USER=
MAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
